NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
PROCESSOR_URL=
PROCESSOR_SECRET=

# Optional: run the LLM (outfit composition + photo tagging) through OpenRouter.
# If OPENROUTER_API_KEY is set, both use OpenRouter (falling back to Gemini on error).
# Swap models freely — any slug from https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional: use a different (must be multimodal) model just for photo tagging.
# Defaults to OPENROUTER_MODEL. Set this if OPENROUTER_MODEL is text-only (e.g. deepseek).
OPENROUTER_VISION_MODEL=